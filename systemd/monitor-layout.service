[Unit]
Description=Restore the saved monitor arrangement at login (GNOME)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
# Monitors enumerate a few seconds into the session; retry a handful of times.
# monitor-layout.py is idempotent — it no-ops as soon as the arrangement is correct.
ExecStart=/bin/sh -c 'for i in 1 2 3 4 5 6; do %h/.local/bin/monitor-layout.py || true; sleep 4; done'

[Install]
WantedBy=graphical-session.target

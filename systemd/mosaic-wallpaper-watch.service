[Unit]
Description=Recompose the mosaic wallpaper when the monitors change (GNOME)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart=%h/.local/bin/mosaic-wallpaper-watch.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
